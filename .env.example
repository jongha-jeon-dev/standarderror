# Copy to .env and fill in. .env is gitignored; never commit real keys.

# ---- Site identity (needed before crossposting to Medium) --------------------
# The canonical home of your posts. Medium's importer points rel=canonical here,
# so search engines credit your domain rather than Medium's.
SITE_BASE_URL=https://jonghajeon.github.io/standarderror
POST_AUTHOR=Jongha Jeon
# Linked from every post. Post.audit() rejects placeholder URLs.
CODE_REPO_URL=https://github.com/jonghajeon/standarderror

# ---- FRED -------------------------------------------------------------------
# OPTIONAL. standarderror.sources.fred.get() uses the keyless fredgraph.csv endpoint.
# A key unlocks the documented API and, importantly, *vintages*
# (realtime_start), which you need for any honest macro backtest.
# Free: https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# ---- Bank of Korea ECOS -----------------------------------------------------
# The literal string "sample" works with no registration but returns at most 10
# rows per call. Register at https://ecos.bok.or.kr/api/ (activation can take a day).
ECOS_API_KEY=sample

# ---- Notion (optional publishing target) ------------------------------------
# Create an internal integration, share the target database with it, then paste
# the database id (the 32-char hex in its URL).
NOTION_TOKEN=
NOTION_DATABASE_ID=

# ---- Behaviour --------------------------------------------------------------
SERR_CACHE=.cache
SERR_BUILD=build
SERR_TTL_HOURS=12
SERR_SEED=20260804

# No key needed, no entry required here: ECB Data Portal, BIS Data Portal, HMDA.
